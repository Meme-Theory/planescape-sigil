{
  "_meta": {
    "name": "english-to-cant rewrites",
    "curated": "2026-06-06",
    "law": "Rewrite law is DATA (the family pattern): templates = whole-intent recasts, substitutions = span swaps, seasoning = density dressing. The engine applies templates → substitutions → seasoning → address, deterministically (crc32 choice, no dice — chance belongs to Modron). Adding a rule = a JSON drop-in + harvest re-run NOT required (engine reads this file live).",
    "fields": {
      "en": "case-insensitive regex over the working text; \\N backrefs usable in out",
      "out": "ranked replacements, PLAIN-first → ORNATE-last; light density sees out[0], street the first two, heavy all",
      "term": "lexicon link for def/tier/attestation in the suggestions payload",
      "min_density": "rule sleeps below this density (light < street < heavy); default light",
      "note": "honesty channel — semantic drift, faction-specificity, register warnings"
    }
  },
  "templates": [
    {"id": "greet-bare", "intent": "greeting", "en": "^\\s*(hi|hello|hey|greetings|well met|good (?:morning|day|evening))[,.!\\s]*$", "out": ["Lady's grace, {addr}.", "What's the chant, {addr}?", "Lady's grace on you, {addr}."], "term": "lady's grace"},
    {"id": "greet-lead", "intent": "greeting", "en": "^\\s*(?:hi|hello|hey|greetings)[,!]?\\s+(.+)$", "out": ["Lady's grace, {addr} — \\1", "What's the chant, {addr}? \\1"], "term": "lady's grace", "min_density": "street"},
    {"id": "farewell", "intent": "farewell", "en": "^\\s*(goodbye|bye|farewell|see you(?: later| around)?|so long)[,.!\\s]*$", "out": ["Watch the Spire, {addr}.", "Spire's ward, {addr}.", "Believe well, {addr}."], "term": "spire's ward"},
    {"id": "whats-new", "intent": "query-news", "en": "\\bwhat'?s? (?:is )?(?:new|going on|happening|the news|the word)\\b", "out": ["what's the chant", "what's the chant on the streets"], "term": "the chant"},
    {"id": "tell-me-about", "intent": "query-info", "en": "\\b(?:tell me (?:about|of)|what do you know (?:about|of)|give me the details on)\\s+", "out": ["lann me the dark of ", "what's the chant on ", "give me the dark of "], "term": "dark"},
    {"id": "shut-up", "intent": "silence", "en": "\\b(?:shut up|be quiet|quiet down|shut your mouth|hold your tongue|stop talking)\\b", "out": ["bar that", "shut your bone-box", "stitch your lips"], "term": "bar that"},
    {"id": "go-away", "intent": "dismissal", "en": "\\b(?:go away|get out(?: of here)?|leave me alone|buzz off|beat it|get lost)\\b", "out": ["pike it", "pike off"], "term": "pike it"},
    {"id": "understand-q", "intent": "query-understanding", "en": "\\b(?:do you understand(?: me)?|you get me|are you following)\\b", "out": ["you scan, {addr}", "you scan me", "do you tumble to it"], "term": "scan"},
    {"id": "understand-ack", "intent": "acknowledge", "en": "\\b(?:i understand|i get it|i see what you mean|understood)\\b", "out": ["I scan it", "I tumble to it", "scanned and squared"], "term": "tumble to"},
    {"id": "kill-threat", "intent": "threat", "en": "\\bi(?:'ll| will| am going to) kill you\\b", "out": ["you're for the dead-book, {addr}", "I'll pen you in the dead-book myself"], "term": "dead-book"},
    {"id": "be-careful", "intent": "warning", "en": "\\b(?:be careful|watch yourself|watch out|stay alert|keep your guard up)\\b", "out": ["stay peery", "keep peery, {addr}", "walk peery — the Cage bites"], "term": "peery"},
    {"id": "curse-hell", "intent": "curse", "en": "\\b(?:go to hell|damn you(?: to hell)?|to hell with (?:you|it|this))\\b", "out": ["go to the Mazes", "hope the Lady mazes you", "the Mazes take you"], "term": "the mazes"},
    {"id": "how-much", "intent": "query-price", "en": "\\bhow much (?:is (?:it|this|that)|does (?:it|this|that) cost|do you want(?: for (?:it|this|that))?)\\b", "out": ["how much jink", "what's the jink on it"], "term": "jink"},
    {"id": "impossible", "intent": "refusal", "en": "\\b(?:no way|it'?s impossible|it can'?t be done|not a chance)\\b", "out": ["it's a blind", "that's a spireclimb", "tanar'ri's chance in Nessus, that"], "term": "blinds"},
    {"id": "dont-know", "intent": "ignorance", "en": "\\b(?:i (?:don'?t|do not) know|no idea|beats me|i haven'?t a clue)\\b", "out": ["that's a dark to me", "it's a demiplane to me"], "term": "dark", "note": "'a dark to me' = a secret I don't hold"},
    {"id": "trust-me", "intent": "assurance", "en": "\\b(?:trust me|i promise(?: you)?|i swear(?: it)?|you have my word)\\b", "out": ["sure as Sigil"], "term": "sure as sigil"},
    {"id": "surprise", "intent": "exclamation", "en": "\\b(?:oh my god(?:s)?|good grief|holy (?:cow|hell)|good heavens|my goodness)\\b", "out": ["by the Lady", "powers above", "swob me bob"], "term": "the lady"},
    {"id": "thats-crazy", "intent": "disbelief", "en": "\\bthat'?s (?:crazy|insane|nuts|madness)\\b", "out": ["that's barmy", "barmy, that", "that's a slaad-story"], "term": "barmy"},
    {"id": "whats-hurry", "intent": "query", "en": "\\bwhat'?s the (?:hurry|rush)\\b", "out": ["where's the War"], "term": "blood war"},
    {"id": "its-true", "intent": "assurance", "en": "\\b(?:it'?s (?:the )?truth|it'?s true|honest truth)\\b", "out": ["it's the dark of it", "that's the chant, true and square"], "term": "dark"}
  ],
